# Frontera settings for site/lib/herdr-site.sh.
#
# Install with:
#     mkdir -p ~/.config/herdr-slurm
#     ln -sf ~/herdr/scripts/frontera/site.env ~/.config/herdr-slurm/site.env
#
# Inspect what the site layer resolved, and where each value came from:
#     herdr site
#
# Every value here overrides a probe that gets Frontera wrong. Nothing in site/ is
# patched to accommodate this cluster; these are its own documented knobs.

# The probe looks for python >= 3.11 and finds none: Frontera's newest module is
# 3.9.2 and /usr/bin/python3 is 3.6.8. 3.9.2 runs the provider correctly (verified
# in both modes, plus --selftest); 3.6.8 cannot parse it at all. This points at a
# wrapper rather than the interpreter because the module python needs its own lib
# dir, the Intel runtime, and gcc's libssp ahead of Juliaup's broken copy -- see
# scripts/frontera/python3-frontera.sh.
HERDR_SITE_PYTHON=/home1/08526/jdgeorga/herdr/scripts/frontera/python3-frontera.sh

# The login-node probe derives a prefix from `hostname -s` by stripping from the
# first digit. That is right on a login node and wrong everywhere else: run from
# compute node c101-212 it yields prefix "c" and pattern "^c[0-9]+$", so every real
# login node is rejected as "not a login node of this cluster". Frontera usage is
# specifically FROM a compute node, so both values are pinned here.
#
# Set BOTH. LOGIN_PATTERN is probed independently of LOGIN_PREFIX, so overriding the
# prefix alone leaves a stale pattern and the override silently does nothing.
HERDR_SITE_LOGIN_PREFIX=login
HERDR_SITE_LOGIN_PATTERN=^login[0-9]+$

# The default fork binary path is $REPO/target/release/herdr. On Frontera the build
# tree lives on /work2 instead, because /home1 is at ~85% of its 200k inode quota and
# a Rust target dir is tens of thousands of files. CARGO_TARGET_DIR is set to match by
# scripts/frontera/env.sh.
HERDR_SITE_FORK_BIN=/work2/08526/jdgeorga/frontera/herdr-build/target/release/herdr
